# --- Build Stage ---
FROM node:20-alpine AS build

WORKDIR /app

# Copy package configurations and install
COPY frontend/package*.json ./
RUN npm ci

# Copy code files and build
COPY frontend/ .
RUN npm run build

# --- Production Stage ---
FROM nginx:alpine

# Copy built bundle from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
