# LearnWise AI - Environment Variables Configuration

# JWT Authentication secret key (Generate a secure key for production)
JWT_SECRET=your_super_secret_jwt_key_here_2026

# Database Connection (SQLite default, but customizable)
DATABASE_URL=sqlite:///./learnwise.db

# Generative AI API Keys (Optional in Sandbox Mock mode; fill to enable live AI responses)
# Set GEMINI_API_KEY to enable Google Gemini-based generation (default provider if set)
GEMINI_API_KEY=

# Set OPENAI_API_KEY to enable OpenAI-based generation
OPENAI_API_KEY=

# Set ANTHROPIC_API_KEY to enable Anthropic Claude-based generation
ANTHROPIC_API_KEY=
